<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Taiwan Accounting Security Groups -->
        <record id="group_tw_account_user" model="res.groups">
            <field name="name">Taiwan Accounting User</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_tw_account_manager" model="res.groups">
            <field name="name">Taiwan Accounting Manager</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_manager')), (4, ref('group_tw_account_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
