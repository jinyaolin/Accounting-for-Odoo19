<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Invoice Form View Inherit -->
        <record id="view_move_form_inherit_tw" model="ir.ui.view">
            <field name="name">account.move.form.inherit.tw</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <data>
                    <!-- Add Taiwan Invoice Info after partner selection -->
                    <xpath expr="//field[@name='partner_id']" position="after">
                        <group string="Taiwan Uniform Invoice Information" collapse="True">
                            <group>
                                <field name="tw_invoice_type" widget="radio"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="tw_invoice_track" readonly="True"/>
                                <field name="tw_invoice_number" readonly="True"/>
                            </group>
                        </group>
                    </xpath>

                    <!-- B2B Triple Copy Specific Fields -->
                    <xpath expr="//field[@name='tw_invoice_type']" position="after">
                        <group attrs="{'invisible': [('tw_invoice_type', '!=', 'tw_triple')]}">
                            <field name="tw_buyer_vat" required="True"
                                   placeholder="Enter 8-digit VAT number"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="tw_buyer_name"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                    </xpath>

                    <!-- B2C Double Copy Specific Fields -->
                    <xpath expr="//field[@name='tw_invoice_type']" position="after">
                        <group attrs="{'invisible': [('tw_invoice_type', '!=', 'tw_double')]}">
                            <label for="tw_carrier_type" string="Carrier Information"/>
                            <div>
                                <field name="tw_carrier_type"/>
                                <div attrs="{'invisible': [('tw_carrier_type', '=', 'none')]}">
                                    <field name="tw_carrier_num"
                                           placeholder="Enter carrier number"
                                           attrs="{'required': [('tw_carrier_type', 'in', ['mobile_barcode', 'citizen_cert', 'donation_code'])],
                                                   'readonly': [('state', '!=', 'draft')]}"/>
                                </div>
                            </div>

                            <!-- Donation Code Special Handling -->
                            <div attrs="{'invisible': [('tw_carrier_type', '!=', 'donation_code')]}">
                                <field name="tw_donation_unit" required="True"
                                       placeholder="Enter 7-digit donation unit code"
                                       options="{'no_create': True}"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="tw_donation_unit_name" readonly="True"/>
                            </div>
                        </group>
                    </xpath>

                    <!-- Carrier Display Information -->
                    <xpath expr="//field[@name='invoice_line_ids']" position="before">
                        <group attrs="{'invisible': [('tw_carrier_display', '=', 'No Carrier')]}">
                            <field name="tw_carrier_display" readonly="True"/>
                        </group>
                    </xpath>

                    <!-- Carrier History Tab -->
                    <xpath expr="//notebook" position="inside">
                        <page string="Carrier Records" attrs="{'invisible': [('tw_invoice_type', '!=', 'tw_double')]}">
                            <field name="tw_carrier_history_ids" readonly="True">
                                <tree>
                                    <field name="invoice_date"/>
                                    <field name="carrier_type"/>
                                    <field name="carrier_num"/>
                                    <field name="invoice_amount"/>
                                    <field name="donation_unit" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>
